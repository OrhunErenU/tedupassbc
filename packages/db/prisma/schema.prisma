// TEDU Pass — Prisma schema
// Off-chain personal data lives here (KVKK). Only badge hashes go on-chain.

generator client {
  provider      = "prisma-client-js"
  // Include the Vercel serverless runtime engine so production lambdas can find it.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  CLUB_ADMIN
  SKS_ADMIN
}

enum ClubMemberRole {
  PRESIDENT
  BOARD
  MEMBER
}

enum ClubMemberStatus {
  PENDING
  APPROVED
}

enum EventStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum BadgeRole {
  ATTENDEE
  ORGANIZER
  SPEAKER
  MENTOR
  VOLUNTEER
}

model User {
  id            String   @id @default(cuid())
  teduEmail     String   @unique
  name          String?
  studentId     String?  @unique
  walletAddress String?  @unique
  role          UserRole @default(STUDENT)
  isPublic      Boolean  @default(false)
  username      String?  @unique
  avatarUrl     String?  // profile photo (data URL or hosted)
  title         String?  // CV headline, e.g. "Bilgisayar Müh. '26"
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clubs       Club[]        @relation("ClubCreator")
  memberships ClubMember[]
  attendances Attendance[]
  badges      Badge[]
  shareLinks  ShareLink[]
}

model Club {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  logoUrl        String?
  approvedBySks  Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User         @relation("ClubCreator", fields: [createdById], references: [id])
  members   ClubMember[]
  events    Event[]
}

model ClubMember {
  userId   String
  clubId   String
  role     ClubMemberRole   @default(MEMBER)
  title    String?          // role/task description, e.g. "Etkinlik Koordinatörü"
  status   ClubMemberStatus @default(APPROVED) // student self-claims start PENDING
  joinedAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([userId, clubId])
}

model Event {
  id          String      @id @default(cuid())
  clubId      String
  title       String
  description String?
  date          DateTime
  location      String?
  /// Check-in window. Null means "derive from date" (see lib/checkin-code.ts):
  /// multi-day events like ETH Ankara set these explicitly.
  checkinOpensAt  DateTime?
  checkinClosesAt DateTime?
  /// HMAC key behind the rotating check-in code. Never leaves the server.
  qrSecret      String      @unique
  badgeImageUrl String?     // custom badge design uploaded by the club (data URL)
  status        EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  club            Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  badgeTemplates  BadgeTemplate[]
  attendances     Attendance[]
  checkinAttempts CheckinAttempt[]
}

model BadgeTemplate {
  id          String    @id @default(cuid())
  eventId     String
  roleType    BadgeRole
  name        String
  imageUrl    String?
  metadataUri String?

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  badges  Badge[]

  @@unique([eventId, roleType])
}

model Attendance {
  id           String    @id @default(cuid())
  eventId      String
  userId       String
  checkedInAt  DateTime  @default(now())
  role         BadgeRole @default(ATTENDEE)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Badge {
  id              String   @id @default(cuid())
  badgeTemplateId String
  userId          String
  tokenId         String?  @unique
  // NOT unique: batchMint settles every badge of an event in one transaction, so
  // a whole cohort legitimately shares one txHash. A unique constraint here made
  // the second badge of any batch fail to record its mint.
  txHash          String?
  mintedAt        DateTime?
  createdAt       DateTime @default(now())

  badgeTemplate BadgeTemplate @relation(fields: [badgeTemplateId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([badgeTemplateId, userId])
  @@index([txHash])
}

/// A revocable, expiring capability to view one student's transcript without
/// signing in. The transcript used to be addressed by the student's own user id,
/// which meant the URL could never be withdrawn and any leaked id exposed the
/// document. A token decouples the two: the student can hand one out per
/// employer and revoke it later.
model ShareLink {
  id     String @id @default(cuid())
  token  String @unique
  userId String
  /// Student's own note, e.g. "Erasmus başvurusu".
  label  String?
  /// Student numbers stay masked unless the student opts in for this link.
  revealStudentId Boolean @default(false)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Every check-in attempt, accepted or not. Backs the rate limit (an in-memory
/// counter is useless on serverless, where each request may hit a fresh
/// instance) and doubles as the audit trail a university will ask for when a
/// student disputes an attendance record.
model CheckinAttempt {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  ip        String?
  /// Why it was rejected, or "ok". Kept short and non-personal.
  result    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, userId, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}
