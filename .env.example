# Postgres (Railway / Supabase)
DATABASE_URL="postgresql://user:pass@localhost:5432/tedu_pass?schema=public"

# Auth / session
NEXTAUTH_SECRET=""
SESSION_COOKIE_NAME="tedu_pass_session"

# Privy (custodial wallet + email login)
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# Chain (Base Sepolia for MVP)
# Without SERVER_WALLET_PRIVATE_KEY *and* TEDU_PASS_CONTRACT_ADDRESS the app
# runs with the chain disabled: badges queue in the DB and every panel that can
# mint shows a warning banner saying nothing is going on chain.
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
SERVER_WALLET_PRIVATE_KEY=""
TEDU_PASS_CONTRACT_ADDRESS=""
# Optional, for `pnpm --filter @tedu-pass/contracts verify`
BASESCAN_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ALLOWED_EMAIL_DOMAIN="tedu.edu.tr"
